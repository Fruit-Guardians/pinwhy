{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "bin/**",
      "lib/**",
      "web/src/**",
      "scripts/**",
      "plugins/dsh-pinwhy/src/**",
      "plugins/dsh-pinwhy/client/**",
      "site/src/**",
      "test/**/*.test.js",
      "test/helpers/**",
      "!**/node_modules",
      "!public",
      "!dist",
      "!site/dist",
      "!site/public",
      "!test/fixtures",
      "!skills"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "recommended": false
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "useExhaustiveDependencies": "off",
        "useHookAtTopLevel": "off"
      },
      "suspicious": {
        "noEmptyBlockStatements": "error",
        "noVar": "error",
        "noDoubleEquals": "error",
        "noControlCharactersInRegex": "off",
        "noArrayIndexKey": "off",
        "useIterableCallbackReturn": "off",
        "noMisleadingCharacterClass": "off"
      },
      "style": {
        "useConst": "error",
        "noDescendingSpecificity": "off",
        "noNonNullAssertion": "off",
        "useTemplate": "off",
        "useImportType": "off"
      },
      "complexity": {
        "noImportantStyles": "off",
        "useOptionalChain": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["web/src/**", "site/src/**"],
      "linter": {
        "rules": {
          "correctness": {
            "useHookAtTopLevel": "error"
          }
        }
      }
    },
    {
      "includes": ["test/**/*.test.js"],
      "linter": {
        "rules": {
          "suspicious": {
            "noEmptyBlockStatements": "off"
          }
        }
      }
    }
  ]
}
