{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "lib/core.js",
    "lib/store.js",
    "lib/domain/*.js",
    "lib/storage/*.js",
    "lib/queries/context.js",
    "lib/queries/context-render.js",
    "lib/queries/search.js",
    "lib/queries/history.js",
    "lib/queries/digest.js",
    "lib/exports/shared-paths.js",
    "lib/ultra/*.js",
    "lib/hooks/*.js"
  ]
}
