{
  "name": "pinwhy",
  "version": "0.2.0",
  "description": "Pinwhy — Agent 外置记忆：留下判断、证据与现场，跨会话接着思考",
  "homepage": "https://github.com/Fruit-Guardians/pinwhy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fruit-Guardians/pinwhy.git"
  },
  "bugs": {
    "url": "https://github.com/Fruit-Guardians/pinwhy/issues"
  },
  "keywords": [
    "pinwhy",
    "agent-memory",
    "cli",
    "context",
    "local-first"
  ],
  "type": "module",
  "bin": {
    "pinwhy": "./bin/pinwhy.js",
    "pinwhy-ultra": "./bin/pinwhy-ultra.js"
  },
  "files": [
    "bin/",
    "lib/",
    "skills/pinwhy/",
    "skills/pinwhy-ultra/",
    "skills/pinwhy-code-audit/README.md",
    "skills/pinwhy-code-audit/SKILL.md",
    "skills/pinwhy-code-audit/agents/",
    "skills/pinwhy-code-audit/assets/",
    "skills/pinwhy-code-audit/references/",
    "public/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test \"test/unit/*.test.js\" \"test/integration/*.test.js\" \"test/contracts/*.test.js\"",
    "build": "vite build",
    "dev": "vite --host 127.0.0.1",
    "site:dev": "npm --prefix site run dev",
    "site:build": "npm --prefix site run build",
    "serve": "node bin/pinwhy.js serve",
    "ultra": "node bin/pinwhy-ultra.js",
    "demo:ultra": "node scripts/demos/seed-ultra-demo.mjs",
    "demo:ultra:serve": "node bin/pinwhy.js serve --cwd test/fixtures/ultra-demo-board --open",
    "demo:audit": "node scripts/demos/seed-audit-demo.mjs",
    "demo:audit:serve": "node bin/pinwhy.js serve --cwd test/fixtures/audit-demo-board --open",
    "export": "node bin/pinwhy.js export",
    "check": "npm run check:types && npm run check:arch && npm run lint && npm run check:docs && npm run check:publish",
    "check:types": "tsc --noEmit && tsc -p tsconfig.lib.json",
    "check:arch": "node scripts/checks/check-architecture.mjs",
    "lint": "biome lint .",
    "check:docs": "node scripts/checks/check-docs.mjs",
    "check:publish": "node scripts/checks/check-publication.mjs",
    "evaluate:recovery": "node scripts/evaluation/evaluate-recovery.mjs",
    "experiment:recovery": "node scripts/evaluation/recovery-experiment.mjs",
    "verify:recovery": "node scripts/evaluation/recovery-synthetic.mjs",
    "benchmark": "node scripts/evaluation/benchmark.mjs",
    "benchmark:full": "node scripts/evaluation/benchmark.mjs --full",
    "verify:package": "node scripts/packaging/verify-package.mjs",
    "pack:packages": "node scripts/packaging/pack-packages.mjs",
    "verify:npm-packages": "node scripts/packaging/verify-npm-packages.mjs",
    "verify:api": "node scripts/checks/verify-api.mjs",
    "verify:viewer": "node web/scripts/verify-viewer.mjs",
    "verify:audit": "node web/scripts/verify-audit.mjs",
    "verify:exports:text": "node scripts/checks/verify-text-exports.mjs",
    "verify:exports:sarif": "node scripts/checks/verify-sarif.mjs",
    "verify:exports": "npm run verify:exports:text && npm run verify:exports:sarif"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "elkjs": "^0.12.0",
    "github-slugger": "2.0.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.60.0",
    "markdown-it": "15.0.3",
    "mermaid": "11.12.0",
    "parse5": "8.0.1",
    "playwright": "1.64.1",
    "postprocessing": "^6.39.5",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
